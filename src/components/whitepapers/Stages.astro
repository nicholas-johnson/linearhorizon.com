---
interface Stage {
  id: string;
  title: string;
  summary: string;
}

interface Props {
  stages: Stage[];
  class?: string;
}

const { stages, class: className } = Astro.props;

function stageHref(stage: Stage, index: number) {
  return `#stage-${index + 1}-${stage.title.toLowerCase()}`;
}
---

<ol class:list={['border-t border-hairline md:grid md:grid-cols-4', className]}>
  {
    stages.map((stage, index) => (
      <li
        class:list={[
          'border-b border-hairline py-8',
          index < stages.length - 1 && 'md:border-r md:pr-6 lg:pr-8',
          index > 0 && 'md:pl-6 lg:pl-8',
        ]}
      >
        <a href={stageHref(stage, index)} class="group block no-underline">
          <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{stage.id}</p>
          <p class="mt-4 text-[1.15rem] font-medium tracking-tight text-ink group-hover:text-cobalt">
            {stage.title}
          </p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{stage.summary}</p>
          <div class="mt-6 flex items-center gap-1.5" aria-hidden="true">
            {stages.map((_, i) => (
              <span
                class:list={['inline-block h-2 w-2', i <= index ? 'bg-cobalt' : 'bg-hairline']}
              />
            ))}
          </div>
        </a>
      </li>
    ))
  }
</ol>
