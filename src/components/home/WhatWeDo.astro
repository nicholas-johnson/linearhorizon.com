---
import Section from '../Section.astro';
import { pillars } from '../../data/site';
import { products, productHref } from '../../data/products';
---

<Section id="what-we-do" class="pb-16 md:pb-24">
  <div class="mb-10 flex flex-wrap items-baseline justify-between gap-4 border-b border-hairline pb-4">
    <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">What Linear Horizon does</p>
    <p class="max-w-md font-mono text-[11px] tracking-[0.08em] text-muted">
      Two complementary sides of the same practice. You do not have to choose one or the other.
    </p>
  </div>
  <div class="grid gap-0 border-t border-hairline md:grid-cols-2">
    <div class="border-b border-hairline py-10 md:border-r md:border-b-0 md:pr-12 md:py-12">
      <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">Services</p>
      <h2 class="mt-4 text-[1.35rem] font-medium tracking-tight">Train. Advise. Build.</h2>
      <p class="mt-4 max-w-md text-[1.02rem] leading-relaxed text-muted">
        Work with Linear Horizon directly to develop capability, design AI systems and deliver them into production.
      </p>
      <ol class="mt-8 space-y-4">
        {
          pillars.map((item) => (
            <li>
              <a href={item.href} class="group block no-underline">
                <p class="font-mono text-[11px] tracking-[0.16em] text-muted">{item.kicker}</p>
                <p class="mt-1 text-[1.02rem] tracking-tight text-ink group-hover:text-cobalt">
                  {item.lede}
                </p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="py-10 md:py-12 md:pl-12">
      <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">Products</p>
      <h2 class="mt-4 text-[1.35rem] font-medium tracking-tight">Platform. Then the applications.</h2>
      <p class="mt-4 max-w-md text-[1.02rem] leading-relaxed text-muted">
        Linear Horizon Platform is the foundation. Specialist applications apply the same agentic principles to analysis, research, strategy, growth and customer service.
      </p>
      <ol class="mt-8 space-y-4">
        {
          products.map((product) => (
            <li>
              <a href={productHref(product.slug)} class="group block no-underline">
                <p class="font-mono text-[11px] tracking-[0.16em] text-muted">{product.name}</p>
                <p class="mt-1 text-[1.02rem] tracking-tight text-ink group-hover:text-cobalt">
                  {product.framing}. {product.landingLine}
                </p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>
