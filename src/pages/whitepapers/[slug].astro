---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/CtaLink.astro';
import Stages from '../../components/whitepapers/Stages.astro';
import GridFrame from '../../components/diagrams/GridFrame.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const papers = await getCollection('whitepapers');
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);

const pageUrl = new URL(`/whitepapers/${paper.id}/`, Astro.site).toString();
const published = paper.data.pubDate.toISOString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: paper.data.title,
  description: paper.data.description,
  datePublished: published,
  dateModified: published,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  genre: 'Whitepaper',
  image: new URL('/og.png', Astro.site).toString(),
  author: {
    '@type': 'Organization',
    '@id': `${site.url}/#organisation`,
    name: site.name,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${site.url}/#organisation`,
    name: site.name,
    logo: { '@type': 'ImageObject', url: `${site.url}/favicon.svg` },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Whitepapers', item: `${site.url}/whitepapers/` },
    { '@type': 'ListItem', position: 3, name: paper.data.title, item: pageUrl },
  ],
};

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={paper.data.title}
  description={paper.data.description}
  ogType="article"
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <article class="mx-auto max-w-[88rem] px-6 py-16 md:px-10 md:py-24 lg:px-16">
    <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">
      <a href="/whitepapers" class="text-cobalt no-underline hover:text-ink">Whitepapers</a>
    </p>
    <p class="mt-6 font-mono text-[11px] tracking-[0.14em] text-muted">
      {paper.data.kicker}
      <span class="mx-2 text-hairline">/</span>
      <time datetime={published}>{dateFormat.format(paper.data.pubDate)}</time>
    </p>
    <h1 class="mt-4 max-w-3xl text-[2rem] leading-[1.15] font-medium tracking-tight md:text-[2.5rem]">
      {paper.data.title}
    </h1>

    {
      paper.data.stages && (
        <div class="mt-14">
          <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">The model</p>
          <Stages stages={paper.data.stages} />
        </div>
      )
    }

    <div
      class:list={[
        'mt-16',
        paper.data.contents && 'grid gap-12 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:gap-16',
      ]}
    >
      {
        paper.data.contents && (
          <nav aria-label="Contents" class="lg:sticky lg:top-8 lg:self-start">
            <p class="font-mono text-[11px] tracking-[0.18em] text-muted">Contents</p>
            <ol class="mt-4 border-t border-hairline">
              {paper.data.contents.map((item, index) => (
                <li class="border-b border-hairline py-3">
                  <a
                    href={`#${item.id}`}
                    class="flex items-baseline justify-between gap-4 text-ink no-underline hover:text-cobalt"
                  >
                    <span class="text-[0.95rem] tracking-tight">{item.label}</span>
                    <span class="font-mono text-[11px] tracking-[0.14em] text-muted">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div>
        <div class="article-body max-w-2xl text-[1.05rem] leading-relaxed text-muted">
          <Content />
        </div>

        <GridFrame class="mt-16 max-w-2xl bg-paper p-6 md:p-8">
          <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">Next</p>
          <p class="mt-4 text-[1.15rem] font-medium tracking-tight">
            From experimentation to a dependable workflow.
          </p>
          <p class="mt-4 text-[0.98rem] leading-relaxed text-muted">
            Linear Horizon helps teams adopt AI with the methods, integrations and controls each stage actually requires.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <CtaLink href="/contact?interest=consulting">Talk to us</CtaLink>
            <a
              href="/consulting"
              class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
            >
              Consulting
            </a>
          </div>
        </GridFrame>
      </div>
    </div>
  </article>
</BaseLayout>
