---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CourseGrid from '../../components/training/CourseGrid.astro';
import CatalogueFilters from '../../components/training/CatalogueFilters.astro';
import CtaLink from '../../components/CtaLink.astro';
import {
  audienceHref,
  audienceLandings,
  courses,
  courseCategories,
  coursePathways,
  coursesInCategory,
  courseHref,
  getCategory,
  pathwayCourses,
  toCatalogueRecord,
  topicHref,
} from '../../data/courses';
import {
  catalogueIntro,
  bespokeTraining,
  deliveryOptions,
} from '../../data/courses/catalogue';
import { formatPrice, programmeContactHref, programmes } from '../../data/programmes';

const catalogueRecords = courses.map((course) =>
  toCatalogueRecord(course, getCategory(course.category)?.title ?? course.category),
);
---

<BaseLayout
  fullTitle="AI Training for Engineering Teams & Technical Leaders | Linear Horizon"
  description="Practitioner-led AI and technology training for engineering teams, technical leaders and organisations. A course catalogue covering foundations, engineering, RAG, agents, architecture and workshops."
>
  <article class="mx-auto max-w-[88rem] px-6 py-16 md:px-10 md:py-24 lg:px-16">
    <PageIntro kicker="02 / Training" title="A practitioner-led course catalogue.">
      <p>{catalogueIntro}</p>
    </PageIntro>

    <nav aria-label="Training for" class="mt-12">
      <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">
        <a href="/training/for" class="text-muted no-underline hover:text-cobalt">For</a>
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          audienceLandings.map((landing) => (
            <li>
              <a
                href={audienceHref(landing.slug)}
                class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
              >
                {landing.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Course topics" class="mt-8">
      <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">
        <a href="/training/topics" class="text-muted no-underline hover:text-cobalt">Topics</a>
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          courseCategories.map((category) => (
            <li>
              <a
                href={topicHref(category.id)}
                class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
              >
                {category.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <CatalogueFilters total={courses.length} />

    <script type="application/json" id="catalogue-data" set:html={JSON.stringify(catalogueRecords)} />

    <div id="catalogue" class="mt-6">
      <p id="catalogue-empty" hidden class="border-t border-ink/20 pt-10 text-[1.02rem] leading-relaxed text-muted">
        No courses match those filters.
        {' '}
        <button
          type="reset"
          form="catalogue-filters"
          class="text-ink underline-offset-[0.18em] hover:text-cobalt"
        >
          Clear filters
        </button>
        {' '}
        or
        {' '}
        <a href="/contact?interest=train" class="text-ink hover:text-cobalt">talk to us</a>
        about a tailored programme.
      </p>

      {
        courseCategories.map((category, index) => {
          const items = coursesInCategory(category.id);
          return (
            <section
              id={category.id}
              data-category-section
              class="mt-20 scroll-mt-10"
            >
              <div class="border-b border-ink/20 pb-6">
                <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h2 class="mt-3 text-[1.35rem] font-medium tracking-tight">
                  <a href={topicHref(category.id)} class="text-ink no-underline hover:text-cobalt">
                    {category.title}
                  </a>
                </h2>
                <p class="mt-3 max-w-xl text-[1.02rem] leading-relaxed text-muted">
                  {category.summary}
                </p>
              </div>
              <CourseGrid courses={items} interactive />
            </section>
          );
        })
      }
    </div>

    <section id="pathways" class="mt-24">
      <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">Pathways</p>
      <h2 class="text-[1.35rem] font-medium tracking-tight">Suggested learning pathways</h2>
      <p class="mt-4 max-w-xl text-[1.02rem] leading-relaxed text-muted">
        These are starting points, not prescriptions. Most organisations mix courses, shorten them,
        or commission a programme around their own stack and objectives.
      </p>
      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        {
          coursePathways.map((pathway) => {
            const steps = pathwayCourses(pathway.slugs);
            return (
              <div class="border-t border-hairline pt-8">
                <h3 class="text-[1.15rem] font-medium tracking-tight">{pathway.title}</h3>
                <p class="mt-3 max-w-xl text-[0.98rem] leading-relaxed text-muted">
                  {pathway.summary}
                </p>
                <ol class="mt-6 space-y-3">
                  {steps.map((course, index) => (
                    <li class="grid grid-cols-[auto_1fr] gap-3">
                      <span class="font-mono text-[11px] tracking-[0.18em] text-muted">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <a
                          href={courseHref(course.slug)}
                          class="text-ink no-underline hover:text-cobalt"
                        >
                          {course.title}
                        </a>
                        <p class="mt-1 font-mono text-[11px] tracking-[0.12em] text-muted">
                          {course.duration} · {course.level}
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            );
          })
        }
      </div>
    </section>

    <section id="bespoke" class="mt-24 max-w-2xl">
      <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">Bespoke</p>
      <h2 class="text-[1.35rem] font-medium tracking-tight">{bespokeTraining.title}</h2>
      <p class="mt-4 text-[1.02rem] leading-relaxed text-muted">{bespokeTraining.lede}</p>
      <ol class="mt-8 border-t border-hairline">
        {
          bespokeTraining.points.map((item, index) => (
            <li class="grid grid-cols-[auto_1fr] gap-4 border-b border-hairline py-5 md:grid-cols-[5.5rem_1fr] md:gap-10">
              <span class="font-mono text-[11px] tracking-[0.18em] text-muted">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-[1.02rem] leading-relaxed text-muted">{item}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24">
      <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">Python programmes</p>
      <h2 class="text-[1.35rem] font-medium tracking-tight">Flagship Python programmes</h2>
      <p class="mt-4 max-w-xl text-[1.02rem] leading-relaxed text-muted">
        Two priced, lab-intensive programmes taught in Python. They sit alongside the catalogue and
        can be tailored to your team in the same way as the rest of the courses. Each has a public
        lab handbook — the module notes and exercises from the course repository.
      </p>
      <ol class="mt-8 border-t border-ink/20">
        {
          programmes.map((item) => (
            <li class="grid grid-cols-1 gap-3 border-b border-hairline py-10 md:grid-cols-[5.5rem_minmax(0,16rem)_1fr] md:gap-10">
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{item.duration}</p>
              <div>
                <h3 class="text-[1.2rem] font-medium tracking-tight">
                  <a href={`/training/${item.slug}`} class="text-ink no-underline hover:text-cobalt">
                    {item.title}
                  </a>
                </h3>
                <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-muted">
                  From {formatPrice(item.priceFrom)}
                </p>
              </div>
              <div class="max-w-xl">
                <p class="text-[1.02rem] leading-relaxed text-muted">{item.summary}</p>
                <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
                  <a
                    href={`/training/${item.slug}/labs`}
                    class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
                  >
                    Lab handbook
                  </a>
                  <a
                    href={programmeContactHref(item.slug)}
                    class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
                  >
                    Talk to us
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24 max-w-2xl border-t border-hairline pt-10">
      <h2 class="text-[1.15rem] font-medium tracking-tight">{deliveryOptions.title}</h2>
      <p class="mt-4 text-[1.02rem] leading-relaxed text-muted">{deliveryOptions.body}</p>
      <p class="mt-8">
        <CtaLink href="/contact?interest=train">Talk to us about a programme</CtaLink>
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  import { mountCourseCatalogue } from '../../scripts/course-catalogue';
  mountCourseCatalogue();
</script>
