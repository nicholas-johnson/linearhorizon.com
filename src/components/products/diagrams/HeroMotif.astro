---
import GridFrame from '../../diagrams/GridFrame.astro';
import type { ProductSlug } from '../../../data/products';

interface Props {
  slug: ProductSlug;
}

const { slug } = Astro.props;

const copy = {
  platform: {
    kicker: 'Runtime',
    line: 'Events are routed through agent teams to tools, knowledge and escalation.',
  },
  stack: {
    kicker: 'Investigation',
    line: 'A question branches into hypotheses, then converges on evidence.',
  },
  solve: {
    kicker: 'Ledger',
    line: 'A hard problem branches into logic and hypotheses; only an earned node is accepted.',
  },
  wargame: {
    kicker: 'Simulation',
    line: 'Actors, incentives and responses are read as a distribution of outcomes.',
  },
  funnel: {
    kicker: 'Filtration',
    line: 'A wide search space narrows to a few evidence-backed opportunities.',
  },
  callcenter: {
    kicker: 'Conversation',
    line: 'Customers arrive on many channels, stay in one conversation, and the work either resolves or hands off.',
  },
  query: {
    kicker: 'Measurement',
    line: 'Events become metrics, and a question turns those metrics into an investigation.',
  },
  chat: {
    kicker: 'Interface',
    line: 'A message is routed to an agent, worked with tools, and streamed back with its working visible.',
  },
}[slug];
---

<GridFrame class="h-full bg-paper p-6 md:p-8">
  <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">{copy.kicker}</p>
  {
    slug === 'platform' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="8" y="8" width="48" height="22" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="66" y="8" width="48" height="22" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="124" y="8" width="48" height="22" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M32 30v12h90V30" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="74" y="42" width="92" height="22" stroke="currentColor" />
        <path d="M120 64v10" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="16" y="74" width="44" height="20" stroke="#145BFF" />
        <rect x="70" y="74" width="44" height="20" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="124" y="74" width="44" height="20" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="178" y="74" width="44" height="20" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="118" y="50" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  {
    slug === 'stack' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="74" y="6" width="92" height="20" stroke="currentColor" />
        <path d="M120 26v12M40 56V38h160v18" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="8" y="56" width="38" height="18" stroke="currentColor" stroke-opacity="0.5" />
        <rect x="54" y="56" width="38" height="18" stroke="#145BFF" />
        <rect x="100" y="56" width="38" height="18" stroke="currentColor" stroke-opacity="0.5" />
        <rect x="146" y="56" width="38" height="18" stroke="currentColor" stroke-opacity="0.5" />
        <rect x="192" y="56" width="38" height="18" stroke="currentColor" stroke-opacity="0.5" />
        <path d="M73 74v10h94V74" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="74" y="84" width="92" height="20" stroke="currentColor" />
      </svg>
    )
  }
  {
    slug === 'solve' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="74" y="6" width="92" height="18" stroke="currentColor" />
        <path d="M120 24v12M64 50V36h112v14" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="16" y="50" width="56" height="18" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="92" y="50" width="56" height="18" stroke="currentColor" />
        <rect x="168" y="50" width="56" height="18" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M44 68v10h40V68M120 68v10M196 68v10" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="24" y="78" width="40" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="100" y="78" width="40" height="16" stroke="#145BFF" />
        <rect x="176" y="78" width="40" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="118" y="84" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  {
    slug === 'wargame' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <circle cx="40" cy="30" r="12" stroke="currentColor" />
        <circle cx="120" cy="22" r="12" stroke="#145BFF" />
        <circle cx="200" cy="30" r="12" stroke="currentColor" />
        <circle cx="80" cy="74" r="12" stroke="currentColor" stroke-opacity="0.65" />
        <circle cx="160" cy="74" r="12" stroke="currentColor" stroke-opacity="0.65" />
        <path
          d="M52 34l56-8M132 26l56 8M50 40l22 24M190 40l-22 24M92 74h56"
          stroke="currentColor"
          stroke-opacity="0.4"
        />
        <rect x="16" y="98" width="70" height="5" fill="#145BFF" />
        <rect x="92" y="98" width="42" height="5" fill="#145BFF" fill-opacity="0.6" />
        <rect x="140" y="98" width="24" height="5" fill="#145BFF" fill-opacity="0.35" />
      </svg>
    )
  }
  {
    slug === 'funnel' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="8" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="42" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="76" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="110" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="144" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="178" y="8" width="28" height="10" stroke="currentColor" stroke-opacity="0.35" />
        <path d="M22 18v12h196V18" stroke="currentColor" stroke-opacity="0.35" />
        <rect x="40" y="30" width="160" height="14" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M70 44v10h100V44" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="70" y="54" width="100" height="14" stroke="currentColor" />
        <path d="M95 68v10h50V68" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="95" y="78" width="50" height="16" stroke="#145BFF" />
        <rect x="118" y="84" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  {
    slug === 'callcenter' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="8" y="8" width="44" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="8" y="30" width="44" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="8" y="52" width="44" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="8" y="74" width="44" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <path d="M52 16h28V82H52" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="80" y="38" width="86" height="22" stroke="currentColor" />
        <path d="M166 49h18" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="184" y="18" width="48" height="20" stroke="#145BFF" />
        <rect x="184" y="62" width="48" height="20" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="121" y="47" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  {
    slug === 'query' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <path d="M8 96h224" stroke="currentColor" stroke-opacity="0.45" />
        <path d="M8 96V14" stroke="currentColor" stroke-opacity="0.45" />
        <rect x="26" y="66" width="18" height="30" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="58" y="52" width="18" height="44" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="90" y="58" width="18" height="38" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="122" y="34" width="18" height="62" stroke="#145BFF" />
        <rect x="154" y="46" width="18" height="50" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="186" y="70" width="18" height="26" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M35 66l32-14 32 6 32-24 32 12 32 24" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="129" y="24" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  {
    slug === 'chat' && (
      <svg class="mt-6 h-32 w-full text-ink" viewBox="0 0 240 110" fill="none" aria-hidden="true">
        <rect x="8" y="12" width="120" height="22" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M28 34v8l12-8" stroke="currentColor" stroke-opacity="0.55" />
        <rect x="112" y="46" width="120" height="22" stroke="#145BFF" />
        <path d="M212 68v8l-12-8" stroke="#145BFF" />
        <path d="M120 79h16M144 79h28M180 79h20" stroke="currentColor" stroke-opacity="0.5" />
        <rect x="8" y="86" width="70" height="16" stroke="currentColor" stroke-opacity="0.45" />
        <path d="M84 94h20" stroke="currentColor" stroke-opacity="0.4" />
        <rect x="120" y="57" width="4" height="4" fill="#145BFF" />
      </svg>
    )
  }
  <p class="mt-6 max-w-xs font-mono text-[11px] leading-relaxed tracking-[0.08em] text-muted">
    {copy.line}
  </p>
</GridFrame>
