---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, interests, interestAliases } from '../data/site';
import { courses } from '../data/courses';

const courseLabels = Object.fromEntries(courses.map((course) => [course.slug, course.title]));
const enquiryConfig = {
  interestLabels: Object.fromEntries(interests.map((item) => [item.value, item.label])),
  interestAliases,
  courseLabels,
  replyEmail: site.email,
};
---

<BaseLayout
  title="Contact"
  description="Talk to us about training, consulting, a bespoke system, or a Platform and specialist application deployment."
>
  <article class="mx-auto max-w-[88rem] px-6 py-16 md:px-10 md:py-24 lg:px-16">
    <PageIntro kicker="08 / Contact" title="Talk to us.">
      <p>
        Tell us briefly about your organisation and the problem. The form opens a conversation in Callcenter. If email is easier, use
        {' '}
        <a href={`mailto:${site.email}`} class="text-ink hover:text-cobalt">{site.email}</a>.
      </p>
    </PageIntro>

    <form id="enquiry" class="mt-14 max-w-xl border-t border-ink/20 pt-10">
      <script type="application/json" id="enquiry-config" set:html={JSON.stringify(enquiryConfig)} />
      <p id="course-note" class="mb-8 hidden font-mono text-[11px] tracking-[0.14em] text-muted"></p>
      <input type="hidden" name="course" id="course-field" />
      <div
        class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
        aria-hidden="true"
      >
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div id="enquiry-fields" class="space-y-8">
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Name</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-2 w-full border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-2 w-full border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Organisation</span>
          <input
            type="text"
            name="organisation"
            required
            autocomplete="organization"
            class="mt-2 w-full border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Interest</span>
          <select
            name="interest"
            class="mt-2 w-full appearance-none rounded-none border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink"
          >
            {
              interests.map((item) => (
                <option value={item.value} selected={item.value === 'train'}>
                  {item.label}
                </option>
              ))
            }
          </select>
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Context</span>
          <textarea
            name="context"
            required
            rows="6"
            class="mt-2 w-full resize-y border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink"
            placeholder="Tell us about your organisation, the problem, and whether this is training, a system, or a product conversation."
          ></textarea>
        </label>
      </div>
      <p id="enquiry-success" hidden class="mt-10 text-[1.05rem] leading-relaxed text-muted">
        The enquiry is with us. We will reply.
      </p>
      <p
        id="enquiry-status"
        role="status"
        class="mt-6 font-mono text-[11px] tracking-[0.12em] text-muted"
      ></p>
      <button
        type="submit"
        class="mt-10 bg-horizon-600 px-6 py-3 font-mono text-[11px] tracking-[0.16em] text-white transition-colors hover:bg-graphite-950 disabled:cursor-wait disabled:opacity-60"
      >
        Talk to us
      </button>
    </form>
  </article>
</BaseLayout>

<script>
  import { mountEnquiryForm } from '../scripts/enquiry-form';
  mountEnquiryForm();
</script>
