<style>
  .platform-os__line {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    fill: none;
  }

  .platform-os__ring {
    fill: var(--color-paper);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .platform-os__square {
    fill: currentColor;
  }

  .platform-os__draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .platform-os__draw {
      animation: platform-os-draw 640ms var(--ease-brand) both;
      animation-delay: var(--delay, 0ms);
    }

    .platform-os__draw--out {
      animation-duration: 520ms;
      animation-delay: 560ms;
    }

    .platform-os__square,
    .platform-os__outcomes {
      animation: platform-os-in 220ms var(--ease-brand) 1000ms both;
    }
  }

  @keyframes platform-os-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes platform-os-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
