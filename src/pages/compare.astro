---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaLink from '../components/CtaLink.astro';
import OutcomeLine from '../components/brand/OutcomeLine.astro';
import GridFrame from '../components/diagrams/GridFrame.astro';
import ProductNav from '../components/products/ProductNav.astro';
import Limits from '../components/products/Limits.astro';
import CompareTable from '../components/compare/CompareTable.astro';
import CompareModels from '../components/compare/CompareModels.astro';
import { site } from '../data/site';
import {
  comparePage,
  subjects,
  overlap,
  distinctions,
  whenToUse,
  together,
  limits,
  faqs,
} from '../data/compare';

const pageUrl = `${site.url}/compare`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${site.url}/products/` },
    { '@type': 'ListItem', position: 3, name: 'Compare', item: `${pageUrl}/` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: comparePage.seoTitle,
  description: comparePage.seoDescription,
  url: `${pageUrl}/`,
  dateModified: '2026-09-16',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
};
---

<BaseLayout fullTitle={`${comparePage.seoTitle} | Linear Horizon`} description={comparePage.seoDescription}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(webPageLd)} />

  <article class="mx-auto max-w-[88rem] px-6 py-16 md:px-10 md:py-24 lg:px-16">
    <PageIntro kicker={comparePage.kicker} title={comparePage.headline}>
      <p>{comparePage.support}</p>
    </PageIntro>

    <p class="mt-6 font-mono text-[11px] tracking-[0.14em] text-muted">
      {comparePage.label}
      <span class="mx-2 text-hairline">/</span>
      Current as of {comparePage.asOf}
    </p>

    <ProductNav class="mt-12" />

    <p class="mt-12 max-w-2xl text-[1.02rem] leading-relaxed text-muted">
      {comparePage.note}
    </p>

    <ol class="mt-16 grid grid-cols-1 border-t border-hairline lg:grid-cols-3">
      {
        subjects.map((subject, index) => (
          <li
            class:list={[
              'border-hairline py-10',
              index < subjects.length - 1 && 'border-b lg:border-b-0 lg:border-r lg:pr-10',
              index > 0 && 'lg:pl-10',
            ]}
          >
            <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{subject.vendor}</p>
            <h2 class="mt-3 text-[1.25rem] font-medium tracking-tight">
              {subject.href ? (
                <a href={subject.href} class="text-ink no-underline hover:text-cobalt">
                  {subject.name}
                </a>
              ) : (
                subject.name
              )}
            </h2>
            <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-cobalt">{subject.category}</p>
            <p class="mt-5 text-[1.02rem] leading-relaxed text-muted">{subject.oneLiner}</p>
            <p class="mt-4 text-[0.98rem] leading-relaxed text-muted">{subject.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-20">
      <CompareModels />
    </div>

    <div class="mt-20">
      <CompareTable caption="How they differ" />
    </div>

    <section class="mt-24">
      <p class="font-mono text-[11px] tracking-[0.18em] text-muted">Overlap</p>
      <h2 class="mt-3 max-w-xl text-[1.35rem] font-medium tracking-tight">
        They are compared because the overlap is real.
      </h2>
      <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-muted">
        A person can research an account, draft a message and schedule recurring work in all three. That is not a reason to treat them as substitutes.
      </p>
      <ol class="mt-10 grid grid-cols-1 border-t border-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          overlap.map((item, index) => (
            <li
              class:list={[
                'border-b border-hairline py-6',
                index % 2 === 0 ? 'sm:border-r sm:pr-8' : 'sm:pl-8',
                index % 3 !== 2 && 'lg:border-r',
                index % 3 === 0 && 'lg:pr-8 lg:pl-0',
                index % 3 === 1 && 'lg:px-8',
                index % 3 === 2 && 'lg:pl-8 lg:pr-0',
              ]}
            >
              <span class="font-mono text-[11px] tracking-[0.18em] text-muted">{item.id}</span>
              <h3 class="mt-3 text-[1.02rem] font-medium tracking-tight">{item.title}</h3>
              <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24">
      <p class="font-mono text-[11px] tracking-[0.18em] text-muted">What Linear Horizon is for</p>
      <h2 class="mt-3 max-w-xl text-[1.35rem] font-medium tracking-tight">
        The difference is a system, not a more persuasive prompt.
      </h2>
      <ol class="mt-10 border-t border-hairline">
        {
          distinctions.map((item) => (
            <li class="grid gap-3 border-b border-hairline py-8 md:grid-cols-[5.5rem_minmax(0,16rem)_1fr] md:gap-10">
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{item.id}</p>
              <h3 class="text-[1.15rem] font-medium tracking-tight">{item.title}</h3>
              <p class="max-w-xl text-[1.02rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24">
      <p class="font-mono text-[11px] tracking-[0.18em] text-muted">When to use which</p>
      <h2 class="mt-3 max-w-xl text-[1.35rem] font-medium tracking-tight">
        Pick the product that matches the job.
      </h2>
      <ol class="mt-10 border-t border-hairline">
        {
          whenToUse.map((item) => (
            <li class="grid gap-6 border-b border-hairline py-10 lg:grid-cols-[5.5rem_minmax(0,18rem)_1fr] lg:gap-12">
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{item.id}</p>
              <div>
                <p class="font-mono text-[11px] tracking-[0.16em] text-cobalt">{item.subject}</p>
                <h3 class="mt-3 text-[1.15rem] font-medium tracking-tight">{item.title}</h3>
              </div>
              <p class="max-w-xl text-[1.02rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24 grid gap-10 border-t border-hairline pt-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">{together.caption}</p>
      <div class="max-w-2xl">
        <h2 class="text-[1.35rem] leading-snug font-medium tracking-tight">{together.title}</h2>
        <p class="mt-5 text-[1.05rem] leading-relaxed text-muted">{together.body}</p>
        <p class="mt-6">
          <a
            href="/products"
            class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
          >
            Linear Horizon products
          </a>
        </p>
      </div>
    </section>

    <div class="mt-24">
      <Limits
        items={[...limits]}
        caption="Limits worth being clear about"
        title="What this comparison does not claim."
      />
    </div>

    <section class="mt-24">
      <p class="font-mono text-[11px] tracking-[0.18em] text-muted">Questions</p>
      <h2 class="mt-3 text-[1.35rem] font-medium tracking-tight">Short answers.</h2>
      <ol class="mt-10 border-t border-hairline">
        {
          faqs.map((item, index) => (
            <li class="border-b border-hairline py-8">
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-3 max-w-2xl text-[1.15rem] font-medium tracking-tight">{item.question}</h3>
              <p class="mt-3 max-w-2xl text-[1.02rem] leading-relaxed text-muted">{item.answer}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-24 grid gap-8 border-t border-hairline pt-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end">
      <div>
        <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">Talk to us</p>
        <h2 class="mt-4 max-w-lg text-[1.45rem] leading-[1.25] font-medium tracking-tight md:text-[1.7rem]">
          Have a process that needs to become a system?
        </h2>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <CtaLink href="/contact?interest=platform">Talk to us</CtaLink>
          <OutcomeLine class="hidden sm:inline-block" />
        </div>
      </div>
      <GridFrame class="bg-paper p-6 md:p-8">
        <p class="font-mono text-[11px] tracking-[0.18em] text-muted">Where to start</p>
        <p class="mt-4 max-w-sm text-[0.95rem] leading-relaxed text-muted">
          If the job is already Funnel, Stack, Wargame or Callcenter, start with the product. If it is not, we still train, design and build.
        </p>
      </GridFrame>
    </section>
  </article>
</BaseLayout>
