---
import ProductLine from '../brand/ProductLine.astro';
import GridFrame from '../diagrams/GridFrame.astro';
import { getFoundationProducts, getApplicationProducts } from '../../data/products';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Product system' } = Astro.props;
const foundation = getFoundationProducts();
const applications = getApplicationProducts();
const foundationNames = foundation.map((product) => product.name).join(', ');
const applicationNames = applications.map((product) => product.name).join(', ');
const verb = foundation.length === 1 ? 'is' : 'are';
const figcaption = `Linear Horizon products as one system. ${foundationNames} ${verb} the agentic foundation. ${applicationNames} apply that foundation to analysis, research, strategy, growth, customer service, measurement and conversation.`;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <div class="px-5 py-5 md:px-8 md:py-6">
      <ProductLine />
    </div>
  </GridFrame>
  <figcaption class="sr-only">{figcaption}</figcaption>
</figure>
